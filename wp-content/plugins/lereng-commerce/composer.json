{
  "name": "geffaa/lereng-commerce",
  "description": "Store logic for Lereng Coffee Roasters (WooCommerce)",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": { "phpunit/phpunit": "^11.5" },
  "autoload": { "psr-4": { "Lereng\\": "src/" } },
  "autoload-dev": { "psr-4": { "Lereng\\Tests\\": "tests/" } },
  "scripts": { "test": "phpunit --colors=always" },
  "config": { "sort-packages": true }
}
